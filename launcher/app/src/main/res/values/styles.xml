<!-- Tinh chỉnh TopButton dạng hình tròn tối giản căn giữa tuyệt đối chuẩn Apple TV -->
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Frosted circular icon button, Apple TV style. -->
    <style name="TopButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:tint">@drawable/pill_text</item>
        <item name="android:scaleType">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
